# CyberSentinel AI Environment Configuration
# Copy this file to .env and set your keys if available.
# The app works in 100% functional fallback mode even if GEMINI_API_KEY is not set!

# Google Gemini API Key (Get free key from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# AI Model Selection
GEMINI_MODEL=gemini-1.5-flash

# Flask Configuration
FLASK_ENV=development
FLASK_PORT=5000
SECRET_KEY=cybersentinel-enterprise-soc-token-key-2026
